# Copiá este archivo a .env y completá tus valores. No subas .env al repo.
# La app valida estas variables al arrancar (lib/env.ts) y avisa cuál falta.

# Conexión a Postgres (Neon u otro). Formato: postgresql://usuario:clave@host/base?sslmode=require
DATABASE_URL=

# Secreto de Better Auth (mínimo 32 caracteres). Generá uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la app (en local: http://localhost:3000; en producción: tu dominio https)
BETTER_AUTH_URL=http://localhost:3000

# Ingreso con Google (opcional). Si falta alguna de las dos, el botón de Google queda deshabilitado.
# URI de redirección autorizada en Google Cloud Console: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos (separados por coma) que reciben el rol SUPERADMIN al ingresar con Google (correo verificado).
# El panel /admin no tiene registro público. Ej.: admin@tuempresa.com,otra@tuempresa.com
ADMIN_EMAILS=
